# Токен бота (BotFather)
BOT_TOKEN=123456:AAAA-your-bot-token

# API_ID / API_HASH — берутся на my.telegram.org, нужны для юзер-сессий (Pyrogram)
API_ID=1234567
API_HASH=your_api_hash

# Telegram ID администратора (для него не нужен язык/капча)
ADMIN_ID=5877790074

# --- Логика автопокупки ---
# Бот покупает любой лот на перепродаже NFT-подарка, чья цена попадает
# в этот диапазон (включительно), независимо от обычной цены подарка.
SNIPE_MIN_PRICE=125
SNIPE_MAX_PRICE=275

# Интервал опроса маркета, секунды
POLL_INTERVAL=5

# Пауза между проверкой лотов КАЖДОГО отдельного подарка внутри одного
# цикла (в секундах). Без неё Telegram быстро включает антифлуд
# (FLOOD_WAIT) на payments.GetResaleStarGifts, если подарков с активной
# перепродажей много. Если ловите частые "Sleeping for Ns ... flood
# wait" в логах — увеличьте это значение.
GIFT_CHECK_DELAY=1.5

# Путь к файлу базы данных (SQLite)
DB_PATH=bot/database.sqlite3
